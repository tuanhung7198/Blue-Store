/* --- 1. CẤU HÌNH CHUNG --- */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: #ffffff;
  color: #333;
  line-height: 1.6;
}

/* --- 2. MAIN NAVBAR --- */
.main-header {
  background-color: #ffffff;
  border-bottom: 1px solid #e5e7eb;
  position: sticky;
  top: 0;
  z-index: 999;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40px;
  height: 70px;
}

.nav-left .logo {
  font-size: 32px;
  font-weight: 900;
  letter-spacing: 3px;
  font-family: "Arial Black", sans-serif;
  color: #000000;
  text-decoration: none;
}

.nav-center {
  flex-grow: 1;
  display: flex;
  justify-content: center;
}

.nav-links {
  display: flex;
  gap: 32px;
  list-style: none;
}

.nav-links a {
  font-size: 14px;
  font-weight: 500;
  color: #4b5563; /* Muted gray for links matching the image */
  position: relative;
  text-decoration: none;
  transition: color 0.2s;
}

.nav-links a:hover {
  color: #000000;
}

/* Utilities Area */
.nav-right {
  display: flex;
  align-items: center;
  gap: 32px;
}

.lang-currency {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 500;
  color: #4b5563;
  cursor: pointer;
}

.lang-currency .flag {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  object-fit: cover;
}

.utilities {
  display: flex;
  align-items: center;
  gap: 24px;
  font-size: 18px;
}

.utilities a {
  color: #111827;
  text-decoration: none;
}

.cart-icon {
  position: relative;
}

.cart-badge {
  position: absolute;
  top: -6px;
  right: -8px;
  background-color: #000000;
  color: #ffffff;
  font-size: 10px;
  font-weight: 700;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* --- 2.5. SHOP BY CATEGORY (Mua sắm theo loại gear) --- */
.shop-by-category {
  max-width: 1450px;
  margin: 60px auto 20px auto;
  padding: 0 15px;
}

.category-header {
  display: block; /* Hủy flex cũ để xuống dòng */
  margin-bottom: 30px;
  border-bottom: 1px solid #e5e7eb;
  padding-bottom: 15px;
}

.category-title-area {
  text-align: center; /* Căn giữa toàn bộ chữ */
  margin-bottom: 15px;
}

.category-title-area h2 {
  font-family: "Roboto", sans-serif;
  font-weight: 900;
  text-transform: uppercase;
  font-size: 41px; /* Trùng size với trending-title */
  color: #222; /* Đồng bộ màu chữ */
  letter-spacing: 1px;
  margin-bottom: 8px;
}

.category-title-area p {
  color: #6b7280;
  font-size: 15px;
  font-family: "Roboto", sans-serif;
}

.view-all-wrapper {
  display: flex;
  justify-content: flex-end; /* Đẩy nút sang phải */
  width: 100%;
}

.view-all-link {
  font-family: "Roboto", sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: #111827;
  text-decoration: none;
  border: 1px solid #d1d5db;
  padding: 10px 20px;
  border-radius: 30px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s;
}

.view-all-link:hover {
  border-color: #000000;
}

.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
}

.cat-card {
  background: linear-gradient(135deg, #0f1115 0%, #1a1c23 100%);
  border-radius: 12px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 50px 40px;
  min-height: 280px;
  cursor: pointer;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.cat-card-content {
  position: relative;
  z-index: 3;
  width: 55%;
  color: #fff;
  font-family: "Roboto", sans-serif;
}

.cat-tag {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #9ca3af;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 15px;
  font-weight: 700;
}

.orange-dash {
  width: 25px;
  height: 2px;
  background-color: #ea580c; /* Màu cam */
  display: inline-block;
}

.cat-card h3 {
  font-family: Georgia, "Times New Roman", Times, serif;
  font-size: 32px;
  font-weight: 400;
  margin-bottom: 15px;
}

.cat-card p {
  font-size: 14px;
  color: #ffffff; /* Đổi sang màu trắng để dễ đọc */
  line-height: 1.6;
  margin-bottom: 30px;
}

.explore-btn {
  background-color: #1b2cc1;
  color: #fff;
  border: 2px solid #1b2cc1; /* Border mồi để không bị giật layout */
  padding: 10px 24px;
  font-weight: 700;
  font-size: 14px;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.3s;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.explore-btn:hover {
  border-color: #ffffff;
}

.cat-card-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.cat-card-image::after {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.3); /* Lớp phủ đen mờ 30% */
  z-index: 2;
}

.cat-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Phủ kín toàn bộ thẻ */
  transform: scale(1);
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  /* Xóa drop-shadow vì giờ ảnh đã tràn viền */
}

.cat-card:hover .cat-card-image img {
  transform: scale(1.15); /* Hover vào thì Zoom in (phóng to) */
}

/* --- 2.7. USER FEEDBACK SECTION --- */
.user-feedback {
  max-width: 100%; /* Mở rộng toàn màn hình */
  margin: 60px auto;
  padding: 0 20px; /* Padding 2 bên 20px theo yêu cầu */
  font-family: "Roboto", sans-serif;
  overflow-x: hidden; /* Ngăn scrollbar ngang khi dùng margin âm */
}

.feedback-title {
  font-family: "Roboto", sans-serif;
  font-size: 41px;
  color: #222;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 30px;
  text-align: center; /* Căn giữa */
}

.feedback-carousel {
  overflow: hidden;
  position: relative;
  width: calc(100% + 20px); /* Bù lại khoảng padding-right 20px của section */
  margin-right: -20px; /* Đẩy ra chạm sát viền phải */
}

.feedback-track {
  display: flex;
  gap: 20px;
  transition: transform 0.5s ease-in-out;
  /* Kích thước Track sẽ được kéo giãn bởi con của nó */
}

.feedback-card {
  flex: 0 0 calc(40% - 10px); /* Khoảng 2.5 ảnh hiển thị cùng lúc */
  height: 400px;
  border-radius: 12px;
  overflow: hidden;
  position: relative;
  background-color: #f3f4f6;
}

.feedback-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.feedback-card:hover img {
  transform: scale(1.05);
}

.feedback-tags {
  position: absolute;
  bottom: 20px;
  left: 20px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  z-index: 2;
}

.feedback-tag {
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  padding: 6px 12px;
  font-size: 11px;
  font-weight: 700;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Lớp phủ gradient nhẹ để chữ dễ đọc */
.feedback-card::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 40%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
  z-index: 1;
}

.feedback-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40px;
}

.progress-bar-container {
  flex-grow: 1;
  max-width: 80%;
  height: 3px;
  background: #e5e7eb;
  border-radius: 2px;
  overflow: hidden;
  position: relative;
}

.progress-bar-fill {
  height: 100%;
  width: 25%; /* 1 nấc đầu tiên */
  background: #1b2cc1; /* Màu xanh nước biển */
  transition: width 0.4s ease;
}

.feedback-nav {
  display: flex;
  gap: 12px;
}

.nav-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #374151; /* Xám đậm */
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 14px;
}

.nav-btn:hover {
  background: #1b2cc1; /* Xanh khi có thể bấm */
}

.nav-btn.disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.nav-btn.disabled:hover {
  background: #ef4444; /* Đỏ khi không khả dụng */
}

/* --- 3. TRENDING SECTION --- */
.trending-section {
  max-width: 1450px; /* Mở rộng tối đa để chứa 4 card to */
  margin: 60px auto 40px auto;
  padding: 0 15px;
}

.trending-header {
  margin-bottom: 30px;
}

.trending-title {
  text-align: center;
  position: relative;
  font-family:
    "Roboto", sans-serif; /* Đổi sang Roboto để hỗ trợ tiếng Việt trơn tru */
  font-weight: 900; /* Dùng bản Black của Roboto để chữ dày như Arial Black */
  font-size: 41px; /* Tăng thêm 15px so với 26px */
  color: #222;
  text-transform: uppercase;
  margin-bottom: 15px;
  letter-spacing: 1px;
}

.trending-title::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: #d1d5db;
  z-index: -1;
}

.trending-title span {
  background: #ffffff; /* Cập nhật thành màu trắng thuần */
  padding: 0 20px;
}

.trending-tabs {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 25px;
}

.tab-btn {
  font-family: "Roboto", sans-serif;
  background: transparent;
  border: 1px solid transparent;
  font-size: 19px; /* Tăng thêm 5px so với 14px */
  font-weight: 600;
  color: #9ca3af;
  cursor: pointer;
  padding: 8px 24px; /* Phóng to nút để hợp lệ với chữ mới */
  transition: all 0.2s;
}

.tab-btn:hover {
  color: #4b5563;
}

.tab-btn.active {
  color: #000;
  font-weight: 800;
  border: 1px solid #000;
  border-radius: 8px; /* Bo góc hợp lý hơn với khung to */
}

.tab-divider {
  color: #d1d5db;
  font-size: 16px;
}

/* --- 4. KHUNG LƯỚI SẢN PHẨM (GRID) --- */
.product-grid {
  display: grid;
  grid-template-columns: repeat(
    4,
    minmax(280px, 330px)
  ); /* Cố định 4 thẻ 1 hàng, tự co dãn từ 280-330px */
  justify-content: center; /* Căn giữa 4 thẻ ra giữa màn hình */
  gap: 35px;
}

/* --- 5. CARD SẢN PHẨM --- */
.product-item {
  font-family: "Roboto", sans-serif;
  background-color: #ffffff;
  border: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  transition: transform 0.3s ease;
  cursor: pointer;
  box-shadow: none; /* Bỏ shadow */
}

.product-item:hover {
  transform: translateY(-5px);
}

.card-image-wrapper {
  position: relative;
  width: 100%;
  background-color: #ffffff; /* Đổi sang nền trắng thuần theo yêu cầu */
  padding: 45px 25px 25px 25px; /* Chừa không gian trên cho badge và heart */
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.image-swap-container {
  position: relative;
  width: 100%;
  aspect-ratio: 1.2;
  margin-bottom: 30px;
}

.image-swap-container img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: opacity 0.3s ease-in-out;
}

.image-swap-container .hover-img {
  opacity: 0;
}

.product-item:hover .image-swap-container .main-img {
  opacity: 0;
}

.product-item:hover .image-swap-container .hover-img {
  opacity: 1;
}

/* Badges */
.new-badge {
  position: absolute;
  top: 15px;
  left: 15px;
  background-color: #4b27b5; /* Màu tím chuẩn */
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  padding: 4px 14px;
  border-radius: 20px;
}

.card-heart {
  position: absolute;
  top: 15px;
  right: 15px;
  font-size: 22px;
  color: #333;
  cursor: pointer;
  transition:
    color 0.2s,
    transform 0.2s;
}

.card-heart:hover {
  color: #ef4444;
  transform: scale(1.1);
}

/* Add To Cart Button */
.add-to-cart-btn {
  width: 100%;
  background-color: #fff;
  border: 1px solid #d1d5db; /* Stroke xám */
  color: #111827;
  font-family: "Roboto", sans-serif;
  font-weight: 700;
  font-size: 15px;
  padding: 12px 0;
  cursor: pointer;
  transition: all 0.2s;
  margin-top: auto;
}

.add-to-cart-btn:hover {
  border-color: #000000;
  color: #000000;
}

/* Card Info */
.card-info {
  width: 100%;
  padding: 0 5px;
}

.product-item h3 {
  font-size: 17px;
  font-weight: 700;
  color: #333;
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  height: 2.8em;
}

/* --- 6. HIỂN THỊ GIÁ --- */
.card-price {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 17px;
  color: #6b7280;
  font-weight: 500;
}

.card-price .old-price {
  text-decoration: line-through;
  color: #888;
  font-size: 18px; /* To hơn xíu */
}

.card-price .new-price {
  color: #ff4d4d; /* Đỏ coral */
  font-size: 20px;
  font-weight: 600;
}

/* --- 7. RESPONSIVE DÀNH CHO DI ĐỘNG --- */
@media (max-width: 576px) {
  .product-hot,
  .product-new,
  .product-sale {
    grid-template-columns: repeat(2, 1fr); /* 2 cột trên điện thoại */
    gap: 10px;
  }

  .product-item {
    padding: 10px;
  }

  .product-item img {
    height: 160px;
  }
}

footer {
  background-color: #2c3e50;
  color: #95a5a6;
  text-align: center;
  padding: 20px 15px;
  margin-top: 50px;
  font-size: 0.9rem;
}

footer p {
  margin: 0;
}

/* --- 3. MEGA MENU DROPDOWN --- */
.mega-menu {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  background: #ffffff;
  color: #000000;
  height: 380px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-5px);
  transition:
    opacity 0.3s ease,
    transform 0.3s ease,
    visibility 0.3s ease;
  border-top: 1px solid #e5e7eb;
  border-bottom: 1px solid #e5e7eb;
  box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.1);
}

.main-header.mega-open .mega-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.mega-container {
  display: flex;
  max-width: 1400px;
  margin: 0 auto;
  height: 100%;
  padding: 30px 40px;
}

.mega-sidebar {
  width: 20%;
  border-right: 1px solid #e5e7eb;
  padding-right: 20px;
}

.mega-categories-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-top: 10px;
  list-style: none;
}

.cat-item {
  font-size: 14px;
  font-weight: 500;
  color: #6b7280;
  cursor: pointer;
  position: relative;
  padding-left: 15px;
  transition: all 0.2s;
}

.cat-item:hover,
.cat-item.active {
  color: #000000;
  font-weight: 700;
}

.cat-item.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 18px;
  background-color: #ff5500;
}

.mega-content {
  width: 80%;
  padding-left: 40px;
  display: flex;
  flex-direction: column;
}

.mega-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 25px;
}

.mega-subtitle {
  font-size: 11px;
  color: #9ca3af;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.mega-title {
  font-size: 20px;
  font-weight: 800;
  margin-top: 5px;
  text-transform: uppercase;
}

.view-all {
  font-size: 13px;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 4px;
  color: #000;
}

.mega-products-wrapper {
  position: relative;
  flex-grow: 1;
}

.mega-products-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 15px;
}

.mega-product-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
}

.mega-img-wrapper {
  width: 100%;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15px;
  overflow: hidden;
}

.mega-img-wrapper img {
  max-width: 90%;
  max-height: 90%;
  object-fit: contain;
  transition: transform 0.3s ease;
}

.mega-product-card:hover .mega-img-wrapper img {
  transform: scale(1.1);
}

.mega-product-name {
  font-size: 12px;
  font-weight: 700;
  text-align: center;
  text-transform: uppercase;
  color: #000;
}

.mega-carousel-controls {
  position: absolute;
  bottom: -10px;
  right: 0;
  display: flex;
  gap: 10px;
}

.carousel-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1px solid #e5e7eb;
  background: #ffffff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.2s;
  color: #000;
}

.carousel-btn:hover {
  border-color: #000000;
}

.nav-links a.active-underline {
  text-decoration: underline;
  text-underline-offset: 8px;
  text-decoration-thickness: 1.5px;
  color: #000;
}

/* --- HERO BANNER CAROUSEL --- */
.hero-banner {
  position: relative;
  width: 100%;
  height: calc(100vh - 70px); /* 100vh trừ đi chiều cao của navbar (70px) */
  overflow: hidden;
  background: linear-gradient(
    135deg,
    #000000 0%,
    #000000 45%,
    #6b7280 85%,
    #d1d5db 100%
  );
  z-index: 10; /* Đảm bảo thấp hơn Mega Menu (999) */
  display: flex;
  flex-direction: column;
}

.hero-slides-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}

.hero-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  visibility: hidden;
  transition:
    opacity 0.8s ease-in-out,
    visibility 0.8s ease-in-out;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 2.5rem;
}

/* Lớp nền đen opacity 30% phía trên ảnh */
.hero-slide::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 18; /* Nằm trên ảnh (z-index: 15) và dưới chữ (z-index: 20) */
  pointer-events: none; /* Cho phép click xuyên qua lớp này */
}

.hero-slide.active {
  opacity: 1;
  visibility: visible;
}

.hero-text-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  z-index: 20;
}

.hero-title-main {
  font-size: 5.5rem; /* ~text-7xl */
  font-weight: 900;
  margin: 0;
  line-height: 1.1;
  /* Hiệu ứng metallic 3D */
  background: linear-gradient(to bottom, #ffffff 0%, #d4d4d8 45%, #71717a 100%);
  -webkit-background-clip: text;
  color: transparent;
  filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.5));
  position: relative;
}

.hero-title-main span {
  position: absolute;
  top: -10px;
  right: -35px;
  font-size: 3.5rem;
  font-weight: 900;
}

.hero-subtitle {
  color: #a1a1aa;
  font-size: 0.75rem;
  margin-top: 0.25rem;
  letter-spacing: 0.05em;
}

.hero-slogan {
  color: #ffffff;
  font-size: 1.25rem;
  font-weight: 600;
  margin-top: 0.75rem;
  letter-spacing: 0.1em;
}

.hero-promo {
  color: #ffffff;
  font-size: 1.125rem;
  font-weight: 700;
  text-transform: uppercase;
  margin-top: 0.5rem;
}

.hero-badge {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 9999px;
  color: #ffffff;
  font-size: 0.75rem;
  padding: 0.35rem 1rem;
  margin-top: 1rem;
}

.hero-visual-center {
  position: absolute;
  top: 15%; /* Bắt đầu từ dưới text một chút */
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: flex-end; /* Đính sát xuống đáy taskbar/banner */
  z-index: 15;
  pointer-events: none; /* Tránh cản trở click vào text/nút phía sau nếu có */
}

.hero-visual-center .hero-single-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: bottom center;
  filter: drop-shadow(0 25px 35px rgba(0, 0, 0, 0.6));
  transform: scale(1.4) translateY(5%); /* Scale to lớn và hơi đẩy xuống đáy để tràn mép */
  transform-origin: bottom center;
}

/* Các chỉ báo Carousel */
.hero-indicators {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  z-index: 30;
}

.hero-indicator-bar {
  width: 3rem;
  height: 3px;
  background-color: rgba(255, 255, 255, 0.3);
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.hero-indicator-bar.active {
  background-color: #ffffff;
}

/* Nút quà tặng nổi */
.hero-floating-gift {
  position: absolute;
  bottom: 1.5rem;
  left: 1.5rem;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background-color: #48a9c5;
  color: #ffffff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  cursor: pointer;
  z-index: 30;
  box-shadow: 0 10px 15px -3px rgba(72, 169, 197, 0.4);
  transition: transform 0.2s ease;
}

.hero-floating-gift:hover {
  transform: scale(1.1) translateY(-2px);
}

/* =========================================
   FOOTER SECTION
   ========================================= */
.main-footer {
  background-color: #ffffff; /* Nền trắng trùng với web */
  color: #111827; /* Chữ xám đen */
  padding: 80px 20px 0 20px;
  font-family: "Roboto", sans-serif;
  margin-top: 80px;
  border-top: 1px solid #e5e7eb; /* Đường kẻ mờ phân cách với nội dung trên */
}

.footer-container {
  max-width: 1450px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr;
  gap: 40px;
  padding-bottom: 50px;
  border-bottom: 1px solid #e5e7eb;
}

.footer-logo {
  font-family: "Roboto", sans-serif;
  font-size: 38px;
  font-weight: 900;
  letter-spacing: 2px;
  margin-bottom: 20px;
  color: #1b2cc1; /* Màu xanh nhận diện thương hiệu Blue (dùng mã xanh đậm lúc trước hoặc #3b82f6) */
  text-transform: uppercase;
}

.footer-desc {
  color: #6b7280; /* Màu xám chuẩn */
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 25px;
  padding-right: 40px;
}

.footer-socials {
  display: flex;
  gap: 15px;
}

.footer-socials a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background-color: #f3f4f6;
  color: #4b5563;
  border-radius: 50%;
  text-decoration: none;
  transition: all 0.3s ease;
  font-size: 16px;
}

.footer-socials a:hover {
  background-color: #1b2cc1;
  color: #ffffff;
  transform: translateY(-3px);
}

.footer-col h3 {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 25px;
  color: #111827;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.footer-col ul {
  list-style: none;
}

.footer-col ul li {
  margin-bottom: 15px;
}

.footer-col ul li a {
  color: #6b7280;
  text-decoration: none;
  font-size: 14px;
  transition: color 0.3s ease;
}

.footer-col ul li a:hover {
  color: #1b2cc1; /* Hover vào đổi sang xanh Brand */
}

.contact-col ul li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  color: #6b7280;
  font-size: 14px;
  line-height: 1.6;
}

.contact-col ul li i {
  color: #1b2cc1; /* Icon màu xanh Brand */
  margin-top: 4px;
}

.footer-bottom {
  text-align: center;
  padding: 25px 0;
  color: #9ca3af;
  font-size: 14px;
}
